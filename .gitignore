# ============================================================================
# MpoxHIV vaccine pipeline -- what does NOT belong in version control
# Everything excluded here is either licensed, third-party, regenerable, or
# over GitHub's 100 MB per-file hard limit. TOOLS_INSTALL.txt explains how to
# rebuild each one.
# ============================================================================

# --- LICENSED SOFTWARE. DO NOT COMMIT. -------------------------------------
# FoldX 5 is under an academic licence that does not permit redistribution.
# Each user must request their own copy from foldxsuite.crg.eu
FoldX5/

# --- THIRD-PARTY CODE (2.4 GB) ---------------------------------------------
# BigMHC is someone else's repository. Clone it instead:
#   git clone https://github.com/KarchinLab/bigmhc.git external_tools/bigmhc
external_tools/

# --- OVER GITHUB'S 100 MB PER-FILE LIMIT -----------------------------------
# Fine-tuned ESM-2 classifier (134 MB). Regenerate with
# Phase 1/STEP C/train_esm2_antigenicity.py, or share via Git LFS / Zenodo.
# NOTE: Phase 1C silently falls back to Kolaskar-Tongaonkar alone if missing.
Phase 1/STEP C/models/esm2_antigenicity_finetuned/model.safetensors

# Dependency bundle (446 MB) -- rebuildable from TOOLS_INSTALL.txt
MpoxHIV_External_Dependencies.zip

# --- REGENERABLE DATABASES -------------------------------------------------
# Rebuild both with the curl + makeblastdb commands in TOOLS_INSTALL.txt sec. 2
human_swissprot_db/
toxprot_db/

# --- LARGE REGENERABLE TOOL OUTPUT -----------------------------------------
# AlphaFold multiple-sequence alignments (~95 MB across live + archived runs).
# The ranked models, summary confidences and PAE matrices ARE kept -- those are
# the results. MSAs are intermediate search output, regenerated by re-running
# the job. Pattern matches every AlphaFold_Raw copy, including the archives.
**/AlphaFold_Raw/*/msas/

# Superseded off-spec AlphaFold jobs (27 MB). These are vaccine+TLR CO-FOLDING
# runs from an early approach that was abandoned: Sec. II.B takes the TLR
# structures from RCSB and builds the complexes by HADDOCK docking, so asking
# AlphaFold to co-fold them is off-spec and burned two extra Server jobs.
# Kept on disk as a record, not committed as if it were current work.
Phase 2/AlphaFold Results/

# --- MACHINE / EDITOR NOISE ------------------------------------------------
.DS_Store
__pycache__/
*.pyc
*.pyo
.venv/
.claude/
.cursor/
.vscode/

# --- PERSONAL ---------------------------------------------------------------
Coare Terminal.txt
